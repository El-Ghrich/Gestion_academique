<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox spacing="20.0" xmlns="http://javafx.com/javafx/17W" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.kooralik.miniprojetjavafx.controller.CoursController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <VBox prefWidth="250.0" spacing="10.0">
        <Label text="Gestion des Cours">
            <font><Font name="System Bold" size="18.0" /></font>
        </Label>
        <TextField fx:id="txtCode" promptText="Code (ex: Java)" />
        <TextField fx:id="txtIntitule" promptText="Intitulé" />
        <HBox spacing="10.0">
            <Button onAction="#onAjouter" style="-fx-background-color: #2ecc71;" text="Ajouter" textFill="WHITE" />
            <Button onAction="#onModifier" style="-fx-background-color: #3498db;" text="Modifier" textFill="WHITE" />
            <Button onAction="#onSupprimer" style="-fx-background-color: #e74c3c;" text="Supprimer" textFill="WHITE" />
        </HBox>
    </VBox>

    <TableView fx:id="tableCours" prefWidth="400.0" HBox.hgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCode" maxWidth="1.7976931348623157E308" prefWidth="117.60003507137299" text="Code" />
            <TableColumn fx:id="colIntitule" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="281.5999221801758" text="Intitulé" />
        </columns>
    </TableView>
</HBox>
