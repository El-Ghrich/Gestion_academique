<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<HBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.kooralik.miniprojetjavafx.controller.FiliereController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <VBox spacing="10.0" prefWidth="250.0">
        <Label text="Gestion des Filières">
            <font><Font name="System Bold" size="18.0" /></font>
        </Label>
        <TextField fx:id="txtCode" promptText="Code (ex: INF)" />
        <TextField fx:id="txtNom" promptText="Nom de la filière" />
        <TextArea fx:id="txtDescription" prefHeight="100.0" promptText="Description" />
        <HBox spacing="10.0">
            <Button onAction="#onAjouter" text="Ajouter" style="-fx-background-color: #2ecc71;" textFill="WHITE" />
            <Button onAction="#onModifier" text="Modifier" style="-fx-background-color: #3498db;" textFill="WHITE" />
            <Button onAction="#onSupprimer" text="Supprimer" style="-fx-background-color: #e74c3c;" textFill="WHITE" />
        </HBox>
    </VBox>

    <TableView fx:id="tableFilieres" prefWidth="400.0" HBox.hgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCode" text="Code" prefWidth="100.0" />
            <TableColumn fx:id="colNom" text="Nom" prefWidth="150.0" />
            <TableColumn fx:id="colDesc" text="Description" prefWidth="150.0" />
        </columns>
    </TableView>
</HBox>